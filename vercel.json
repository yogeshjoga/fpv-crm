{
  "functions": {
    "api/private.js": { "includeFiles": "private/**" }
  },
  "rewrites": [
    { "source": "/study-guides/:path*", "destination": "/api/private?p=study-guides/:path*" },
    { "source": "/fpv-build-lab/:path*", "destination": "/api/private?p=fpv-build-lab/:path*" },
    { "source": "/images/fpv-fundamentals/:path*", "destination": "/api/private?p=images/fpv-fundamentals/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/((?!verify).*)",
      "headers": [{ "key": "X-Frame-Options", "value": "SAMEORIGIN" }]
    }
  ],
  "build": {
    "env": {
      "VITE_SUPABASE_URL": "https://txbrnewcztixcagdnnfx.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "sb_publishable_3U5FgNr8wNimcWj8j5pQ9Q_VwF3_c-2"
    }
  }
}
